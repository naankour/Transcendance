generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model actors {
  id                   Int           @id @default(autoincrement())
  tmdb_id              BigInt        @unique
  name                 String        @db.VarChar(255)
  biography            String?
  birthday             DateTime?     @db.Date
  deathday             DateTime?     @db.Date
  place_of_birth       String?       @db.VarChar(255)
  gender               Int?          @db.SmallInt
  known_for_department String?       @db.VarChar(100)
  profile_path         String?
  imdb_id              String?       @db.VarChar(50)
  also_known_as        String[]
  created_at           DateTime?     @default(now()) @db.Timestamp(6)
  updated_at           DateTime?     @default(now()) @db.Timestamp(6)
  movie_actor          movie_actor[]
}

model favorites {
  id       Int    @id @default(autoincrement())
  user_id  Int
  movie_id Int
  movies   movies @relation(fields: [movie_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, movie_id])
}

model genres {
  id          Int           @id @default(autoincrement())
  name        String        @unique
  movie_genre movie_genre[]
}

model movie_actor {
  id             Int     @id @default(autoincrement())
  movie_id       Int
  actor_id       Int
  character_name String?
  credit_id      String  @unique @db.VarChar(100)
  cast_order     Int?
  actors         actors  @relation(fields: [actor_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  movies         movies  @relation(fields: [movie_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([movie_id, actor_id, character_name])
}

model movie_genre {
  id       Int    @id @default(autoincrement())
  movie_id Int
  genre_id Int
  genres   genres @relation(fields: [genre_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  movies   movies @relation(fields: [movie_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([movie_id, genre_id])
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model movies {
  id             Int           @id @default(autoincrement())
  tmdb_id        Int?          @unique
  imdb_id        String?       @unique @db.VarChar(20)
  title          String        @db.VarChar(255)
  synopsis       String?
  poster         String?
  release_date   DateTime?     @db.Date
  metadata       Json?
  average_rating Decimal?      @default(0) @db.Decimal(3, 2)
  created_at     DateTime?     @default(now()) @db.Timestamp(6)
  updated_at     DateTime?     @default(now()) @db.Timestamp(6)
  favorites      favorites[]
  movie_actor    movie_actor[]
  movie_genre    movie_genre[]
  reviews        reviews[]
  watchlist      watchlist[]
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model reviews {
  id         Int       @id @default(autoincrement())
  movie_id   Int
  user_id    Int
  rating     Decimal?  @db.Decimal(2, 1)
  content    String?
  created_at DateTime? @default(now()) @db.Timestamp(6)
  updated_at DateTime? @default(now()) @db.Timestamp(6)
  movies     movies    @relation(fields: [movie_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users      users     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, movie_id])
}

model users {
  id                                 Int         @id @default(autoincrement())
  firstname                          String?     @db.VarChar(30)
  lastname                           String?     @db.VarChar(30)
  username                           String      @unique @db.VarChar(30)
  email                              String      @unique @db.VarChar(255)
  password_hash                      String?     @db.VarChar(255)
  avatar_url                         String?     @default("/avatars/default_avatar.png")
  bio                                String?
  created_at                         DateTime?   @default(now()) @db.Timestamp(6)
  updated_at                         DateTime?   @default(now()) @db.Timestamp(6)
  favorites                          favorites[]
  follows_follows_followed_idTousers follows[]   @relation("follows_followed_idTousers")
  follows_follows_follower_idTousers follows[]   @relation("follows_follower_idTousers")
  reviews                            reviews[]
  watchlist                          watchlist[]
  conversations_as_user_one conversations[] @relation("conversations_user_one")
  conversations_as_user_two conversations[] @relation("conversations_user_two")
  messages                  messages[]
}

model watchlist {
  id       Int    @id @default(autoincrement())
  user_id  Int
  movie_id Int
  movies   movies @relation(fields: [movie_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users    users  @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, movie_id])
}

model follows {
  id                               Int   @id @default(autoincrement())
  follower_id                      Int
  followed_id                      Int
  users_follows_followed_idTousers users @relation("follows_followed_idTousers", fields: [followed_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_follows_follower_idTousers users @relation("follows_follower_idTousers", fields: [follower_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([follower_id, followed_id])
}

model conversations {
  id         Int        @id @default(autoincrement())
  user_one_id Int
  user_two_id Int
  created_at DateTime?  @default(now()) @db.Timestamp(6)
  updated_at DateTime?  @default(now()) @db.Timestamp(6)

  user_one   users      @relation("conversations_user_one", fields: [user_one_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user_two   users      @relation("conversations_user_two", fields: [user_two_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  messages   messages[]

  @@unique([user_one_id, user_two_id])
}

model messages {
  id              Int           @id @default(autoincrement())
  conversation_id Int
  sender_id       Int
  content         String
  created_at      DateTime?     @default(now()) @db.Timestamp(6)
  read_at         DateTime?     @db.Timestamp(6)

  conversation    conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  sender          users         @relation(fields: [sender_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
}
